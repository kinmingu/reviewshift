# Local development only. Copy this file to .env before starting Docker.
POSTGRES_DB=reviewshift
POSTGRES_USER=reviewshift
POSTGRES_PASSWORD=reviewshift_dev_only
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://reviewshift:reviewshift_dev_only@localhost:5432/reviewshift
API_BASE_URL=http://localhost:8000
APP_ENV=development
LOG_LEVEL=INFO
SOURCE_MODE=fixture

# 변화 신호 기준입니다. 통계적 유의성 기준이 아닙니다.
ANALYSIS_MIN_REVIEW_COUNT=30
ANALYSIS_MIN_NEGATIVE_COUNT=5
ANALYSIS_MIN_INCREASE_PP=10.0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:latest
